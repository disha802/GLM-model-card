# Copy to .env (or export in your shell / set in a Colab cell) to override defaults.

# transformers | audiocraft
EMOJIMUSE_MODEL_BACKEND=transformers
EMOJIMUSE_MODEL_NAME=facebook/musicgen-small

# auto | cuda | cpu
EMOJIMUSE_DEVICE=auto

# Load the model at startup (true) or on first request (false)
EMOJIMUSE_WARMUP=true

# Clip length, seconds
EMOJIMUSE_DEFAULT_DURATION=10
EMOJIMUSE_MAX_DURATION=30

# Where rendered .wav files land, and how long to keep them (minutes; 0 = forever)
EMOJIMUSE_AUDIO_DIR=generated_audio
EMOJIMUSE_AUDIO_TTL_MINUTES=120

# "*" or a comma-separated origin list (e.g. https://you.github.io)
EMOJIMUSE_ALLOWED_ORIGINS=*

# Colab tunnel: cloudflared (no signup) | ngrok (needs token below)
EMOJIMUSE_TUNNEL=cloudflared
NGROK_AUTHTOKEN=
